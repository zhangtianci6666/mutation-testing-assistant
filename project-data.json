      "NULL_RETURNS_MUTATOR": "返回 null",
      "PRIMITIVE_RETURNS_MUTATOR": "修改基本类型返回值 (返回 0、false)",
      "TRUE_RETURNS": "将 boolean 返回值替换为 true",
      "FALSE_RETURNS": "将 boolean 返回值替换为 false",
      "CONSTRUCTOR_CALLS_MUTATOR": "移除 new 调用 (new X() → null)",
      "REMOVE_CONDITIONALS_EQUAL_ELSE": "if(cond) → if(false) (总是走 else)",
      "REMOVE_CONDITIONALS_ORDER_ELSE": "while(cond) → while(false) (跳过循环体)",
      "REMOVE_CONDITIONALS_EQUAL_IF": "if(cond) → if(true) (总是走 if)"
    }
