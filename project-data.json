  "killing_rules_index": {
    "_note": "Operator → one-line strategy mapping for quick dispatch. Full code examples in skill.md Mutation Operators section.",
    "rules": [
      {
        "operator": "CONDITIONALS_BOUNDARY_MUTATOR",
        "strategy": "精确边界值; 构造器屏蔽的边界用反射注入"
      },
      {
        "operator": "VOID_METHOD_CALL_MUTATOR",
        "strategy": "验证副作用(状态/输出/异常); 链式void分场景覆盖; 动画用Counting Subclass"
      },
      {
        "operator": "MATH_MUTATOR",
        "strategy": "不对称测试数据(避免0/1); 数组索引全遍历; 构造器参数断言对象内部字段"
      },
      {
        "operator": "RETURN_VALS_MUTATOR",
        "strategy": "精确值断言(assertEquals); 禁止仅assertNotNull/assertTrue"
      },
      {
        "operator": "INCREMENTS_MUTATOR",
        "strategy": "验证精确迭代次数; 断言循环变量最终值"
      },
      {
        "operator": "INVERT_NEGS_MUTATOR",
        "strategy": "数值否定: 正负混合; 布尔否定: 测试true/false双分支"
      },
      {
        "operator": "NEGATE_CONDITIONALS_MUTATOR",
        "strategy": "覆盖条件true和false两个分支"
      },
      {
        "operator": "EMPTY_RETURNS_MUTATOR",
        "strategy": "String/集合精确值断言; 禁止assertNotNull"
      },
      {
        "operator": "NULL_RETURNS_MUTATOR",
        "strategy": "链式调用(.getX().getY())间接杀活null返回(NPE)"
      },
      {
        "operator": "PRIMITIVE_RETURNS_MUTATOR",
        "strategy": "精确值断言; 禁止assertTrue/assertFalse"
      },
      {
        "operator": "TRUE_RETURNS",
        "strategy": "断言返回false的路径存在并测试"
      },
      {
        "operator": "FALSE_RETURNS",
        "strategy": "断言返回true的路径存在并测试"
      },
      {
        "operator": "CONSTRUCTOR_CALLS_MUTATOR",
        "strategy": "断言字段非空且正确初始化"
      },
      {
        "operator": "REMOVE_CONDITIONALS_EQUAL_ELSE",
        "strategy": "覆盖if/else双分支; if分支产生可观测差异状态"
      },
      {
        "operator": "REMOVE_CONDITIONALS_ORDER_ELSE",
        "strategy": "使循环体执行2+次触发AIOOBE或错误状态"
      },
      {
        "operator": "REMOVE_CONDITIONALS_EQUAL_IF",
        "strategy": "构造else分支产生非默认值的场景"
      }
    ]
  },
